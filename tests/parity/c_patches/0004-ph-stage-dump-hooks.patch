+/* dectalk-python port: PH-stage boundary dump hook (Phase A.4) */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+static FILE *_dectalk_dump_fp_ph = NULL;
+static char  _dectalk_dump_ph_dir[1024] = {0};
+
+static void _dectalk_dump_ph_open(void)
+{
+	const char *dir;
+	char path[1024];
+
+	dir = getenv("DECTALK_DUMP_DIR");
+	if (dir == NULL || dir[0] == '\0') {
+		if (_dectalk_dump_fp_ph != NULL) {
+			fclose(_dectalk_dump_fp_ph);
+			_dectalk_dump_fp_ph = NULL;
+			_dectalk_dump_ph_dir[0] = '\0';
+		}
+		return;
+	}
+	if (_dectalk_dump_fp_ph != NULL && strcmp(dir, _dectalk_dump_ph_dir) == 0)
+		return;
+	if (_dectalk_dump_fp_ph != NULL) {
+		fclose(_dectalk_dump_fp_ph);
+		_dectalk_dump_fp_ph = NULL;
+	}
+	if (strlen(dir) + sizeof("/ph.dump") >= sizeof(path))
+		return;
+	snprintf(path, sizeof(path), "%s/ph.dump", dir);
+	_dectalk_dump_fp_ph = fopen(path, "wb");
+	if (_dectalk_dump_fp_ph != NULL) {
+		strncpy(_dectalk_dump_ph_dir, dir, sizeof(_dectalk_dump_ph_dir) - 1);
+		_dectalk_dump_ph_dir[sizeof(_dectalk_dump_ph_dir) - 1] = '\0';
+	}
+}
+
+static void _dectalk_dump_ph_chunk(const unsigned short *buf, unsigned int count)
+{
+	unsigned int i;
+
+	_dectalk_dump_ph_open();
+	if (_dectalk_dump_fp_ph == NULL)
+		return;
+	fprintf(_dectalk_dump_fp_ph, "ph_write %u\n", count);
+	for (i = 0; i < count; i++) {
+		fprintf(_dectalk_dump_fp_ph,
+		        (i + 1 < count) ? "%04x " : "%04x",
+		        (unsigned int)buf[i]);
+	}
+	fputc('\n', _dectalk_dump_fp_ph);
+	fflush(_dectalk_dump_fp_ph);
+}
+
