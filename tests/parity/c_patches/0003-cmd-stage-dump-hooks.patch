+/* ============================================================
+ * dectalk-python port: CMD-stage boundary dump hook (Phase A.4)
+ * ============================================================
+ *
+ * Sibling to the kernel-stage hook in src/dapi/src/api/ttsapi.c
+ * (see tests/parity/c_patches/0002-stage-boundary-dumps.patch).
+ * In SINGLE_THREADED builds (Linux/macOS), lts_loop() is the entry
+ * point of the LTS stage and is called once per 16-bit token by the
+ * CMD stage in lieu of writing to pKsd_t->lts_pipe. Hooking it at
+ * function entry therefore captures the CMD-stage exit boundary.
+ *
+ * File format (cmd.dump): one record per lts_loop call
+ *   cmd_write <count>
+ *   <space-separated %04x words for the chunk>
+ *
+ * count is fixed at 1 here -- lts_loop reads input[0] as the primary
+ * token. Reopened on every DECTALK_DUMP_DIR change so back-to-back
+ * Python calls (each with a fresh temp dir) see independent dumps.
+ * When the env var is unset/empty, the hook is a no-op.
+ */
+#ifdef SINGLE_THREADED
+#include <stdio.h>
+#include <stdlib.h>  /* getenv */
+#include <string.h>  /* strcmp, strncpy, strlen */
+static FILE *_dectalk_dump_fp_cmd = NULL;
+static char  _dectalk_dump_cmd_dir[1024] = {0};
+
+static void _dectalk_dump_cmd_open(void)
+{
+	const char *dir;
+	char path[1024];
+
+	dir = getenv("DECTALK_DUMP_DIR");
+	if (dir == NULL || dir[0] == '\0') {
+		if (_dectalk_dump_fp_cmd != NULL) {
+			fclose(_dectalk_dump_fp_cmd);
+			_dectalk_dump_fp_cmd = NULL;
+			_dectalk_dump_cmd_dir[0] = '\0';
+		}
+		return;
+	}
+	if (_dectalk_dump_fp_cmd != NULL && strcmp(dir, _dectalk_dump_cmd_dir) == 0)
+		return;
+	if (_dectalk_dump_fp_cmd != NULL) {
+		fclose(_dectalk_dump_fp_cmd);
+		_dectalk_dump_fp_cmd = NULL;
+	}
+	if (strlen(dir) + sizeof("/cmd.dump") >= sizeof(path))
+		return;
+	snprintf(path, sizeof(path), "%s/cmd.dump", dir);
+	_dectalk_dump_fp_cmd = fopen(path, "wb");
+	if (_dectalk_dump_fp_cmd != NULL) {
+		strncpy(_dectalk_dump_cmd_dir, dir, sizeof(_dectalk_dump_cmd_dir) - 1);
+		_dectalk_dump_cmd_dir[sizeof(_dectalk_dump_cmd_dir) - 1] = '\0';
+	}
+}
+
+static void _dectalk_dump_cmd_chunk(const unsigned short *buf, unsigned int count)
+{
+	unsigned int i;
+
+	_dectalk_dump_cmd_open();
+	if (_dectalk_dump_fp_cmd == NULL)
+		return;
+	fprintf(_dectalk_dump_fp_cmd, "cmd_write %u\n", count);
+	for (i = 0; i < count; i++) {
+		fprintf(_dectalk_dump_fp_cmd,
+		        (i + 1 < count) ? "%04x " : "%04x",
+		        (unsigned int)buf[i]);
+	}
+	fputc('\n', _dectalk_dump_fp_cmd);
+	fflush(_dectalk_dump_fp_cmd);
+}
+#endif  /* SINGLE_THREADED */
+
 
